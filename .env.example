# ==============================================================================
# Road System Control — Environment Variables Template
# Copy this file to '.env' and update with your actual PostgreSQL credentials.
# NOTE: Never commit your real '.env' with sensitive credentials to source control.
# ==============================================================================

# PostgreSQL Connection URL
# Standard format: postgresql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/road_system_control

# Authentication & JWT Security Settings (Phase 11)
# Generate a cryptographically secure key: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_strong_64_character_hex_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Enforce strict authentication across all endpoints (true = strict, false = allows legacy fallback)
AUTH_ENFORCE_ALL=false
